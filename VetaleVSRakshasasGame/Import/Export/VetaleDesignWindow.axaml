<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="VetaleBrowser.Export.VetaleDesignWindow"
        Title="Vetale Browser"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Width="1200"
        Height="800"
        CanResize="True"
        MinWidth="480"
        MinHeight="320"
        Padding="0"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        UseLayoutRounding="True">

  <!-- ТІЛЬКИ ДИЗАЙН. Без логіки, без WebView, без сервісів. -->

  <Window.Resources>
    <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFE0E0E0" Offset="0"/>
      <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
      <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
      <GradientStop Color="#FFC0C0C0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFA020F0" Offset="0"/>
      <GradientStop Color="#FF9A1CE8" Offset="0.3"/>
      <GradientStop Color="#FF8E15DC" Offset="0.7"/>
      <GradientStop Color="#FF8612D0" Offset="1"/>
    </LinearGradientBrush>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.window-control">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#303030"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="#40FFFFFF"/>
    </Style>
    <Style Selector="Button.window-control.close">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.window-control.close:pointerover">
      <Setter Property="Background" Value="#40FF5C5C"/>
      <Setter Property="Foreground" Value="#FF000000"/>
    </Style>

    <!-- Мок вкладки: тільки візуал -->
    <Style Selector="Border.mock-tab">
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="CornerRadius" Value="8,8,0,0"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="Border.mock-tab.active">
      <Setter Property="Background" Value="#FFFFFFFF"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Ряд вкладок + кнопки вікна -->
    <Grid Name="TabBarRow" Grid.Row="0" Height="42"
          Background="{StaticResource GrayGradient}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="8,0,0,0" Spacing="4">
          <Button Width="32" Height="32" Background="Transparent"
                  BorderThickness="0" Content="+" FontSize="18"/>
          <Border Classes="mock-tab active" Width="200">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Ellipse Grid.Column="0" Width="16" Height="16" Fill="#FFA020F0"/>
              <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                         Text="New Tab" Foreground="#303030"/>
              <TextBlock Grid.Column="2" VerticalAlignment="Center"
                         Text="✕" Foreground="#808080"/>
            </Grid>
          </Border>
          <Border Classes="mock-tab" Width="200" Opacity="0.7">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Ellipse Grid.Column="0" Width="16" Height="16" Fill="#C0C0C0"/>
              <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                         Text="New Tab" Foreground="#303030"/>
              <TextBlock Grid.Column="2" VerticalAlignment="Center"
                         Text="✕" Foreground="#808080"/>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="window-control" Content="&#xE921;"/>
          <Button Classes="window-control" Content="&#xE922;"/>
          <Button Classes="window-control close" Content="&#xE8BB;"/>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Навігаційна смуга (мок) -->
    <Grid Grid.Row="1" Height="36" Background="{StaticResource PurpleGradient}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="8,0">
        <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                Foreground="White" Content="←" FontSize="16" Width="36"/>
        <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                Foreground="White" Content="→" FontSize="16" Width="36"/>
        <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                Foreground="White" Content="⟳" FontSize="14" Width="36"/>
        <Border Grid.Column="3" Background="#FFFFFFFF" CornerRadius="12"
                Height="26" VerticalAlignment="Center" Padding="12,0">
          <TextBlock VerticalAlignment="Center" Foreground="#808080"
                     Text="Search or enter address"/>
        </Border>
        <Button Grid.Column="4" Background="Transparent" BorderThickness="0"
                Foreground="White" Content="⌂" FontSize="16" Width="36"/>
        <Button Grid.Column="5" Background="Transparent" BorderThickness="0"
                Foreground="White" Content="☆" FontSize="16" Width="36"/>
        <Button Grid.Column="6" Background="Transparent" BorderThickness="0"
                Foreground="White" Content="⋯" FontSize="16" Width="36"/>
      </Grid>
    </Grid>

    <!-- Контент-плейсхолдер: сюди інший додаток кладе свій контент -->
    <Border Grid.Row="2" Background="#FFFFFF">
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="#B0B0B0" FontSize="14"
                 Text="Content placeholder"/>
    </Border>
  </Grid>
</Window>
